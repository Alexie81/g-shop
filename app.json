{
  "expo": {
    "name": "G-Shop",
    "slug": "g-shop",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./logo/app-icon-v2.png",
    "scheme": "gshop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.gshop.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ro.gshop.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./logo/app-icon-v2.png",
        "backgroundColor": "#F6F9FF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./logo/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo/app-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F6F9FF",
          "dark": {
            "backgroundColor": "#061226"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "G-Shop folosește camera pentru scanarea codurilor QR ale clienților.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "G-Shop accesează fotografiile pentru atașamentele fișelor de service.",
          "savePhotosPermission": "G-Shop salvează codurile QR în galeria telefonului.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "G-Shop accesează fotografiile pentru a selecta ștampila firmei."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permite G-Shop să securizeze sesiunea cu Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./logo/app-icon.png",
          "color": "#075CFF",
          "defaultChannel": "service-reminders"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "releaseVersion": "1.1.21",
      "router": {},
      "eas": {
        "projectId": "2fe0de49-704b-49f7-a4ef-0f78c8195e08"
      }
    },
    "owner": "cabitexpert",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2fe0de49-704b-49f7-a4ef-0f78c8195e08"
    }
  }
}
