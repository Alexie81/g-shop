{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://reparatiicalculatoare-bucuresti.ro/app-api",
        "EXPO_PUBLIC_SHOP_API_URL": "https://calculatoareprofesionale.ro/app-api",
        "EXPO_PUBLIC_SCOOTER_API_URL": "https://gshop-trotinete.ro/app-api"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
